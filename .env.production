# Cấu hình khi build production (npm run build). Biến VITE_* được gắn vào lúc build: sửa xong phải build lại.
# Chỉ chứa giá trị công khai, KHÔNG đặt client secret hay khoá bí mật nào ở đây.

# URL gốc của API. /api/v1 = backend cùng domain với frontend (reverse proxy /api -> Laravel)
# Nếu backend nằm ở domain riêng thì ghi đầy đủ, vd. https://api.a51.vn/api/v1
VITE_API_BASE_URL=/api/v1

# Production luôn gọi backend thật
VITE_MOCK_AUTH=false
VITE_MOCK_MARKETPLACE=false

# SEO
VITE_SITE_URL=https://a51.vn
VITE_SEO_IMAGE=

# Đăng nhập bằng Google: OAuth Client ID "Web application" (production)
# Authorized JavaScript origins phải có https://a51.vn (và https://www.a51.vn nếu dùng)
VITE_GOOGLE_CLIENT_ID=977300052886-l33unkje4uio65h100q1o76c257jgu8s.apps.googleusercontent.com