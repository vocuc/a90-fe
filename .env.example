# URL gốc của API. Khi chạy dev, để /api/v1 để đi qua proxy của Vite (xem vite.config.js)
VITE_API_BASE_URL=/api/v1
# Backend Laravel mà proxy của Vite chuyển tiếp tới (chỉ dùng khi npm run dev)
VITE_API_PROXY_TARGET=http://a90.local

# true = dùng dữ liệu giả lập trong src/api/mock, false = gọi backend thật
# Đăng ký / đăng nhập / đăng xuất / thông tin tài khoản
VITE_MOCK_AUTH=false
# Danh mục, AI Creative
VITE_MOCK_MARKETPLACE=false
