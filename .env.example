# URL gốc của API. Khi chạy dev, để /api/v1 để đi qua proxy của Vite (xem vite.config.js)
VITE_API_BASE_URL=/api/v1
# Backend Laravel mà proxy của Vite chuyển tiếp tới (chỉ dùng khi npm run dev)
VITE_API_PROXY_TARGET=http://a90.local

# true = dùng dữ liệu giả lập trong src/api/mock, false = gọi backend thật
# Đăng ký / đăng nhập / đăng xuất / thông tin tài khoản
VITE_MOCK_AUTH=false
# Danh mục, AI Creative
VITE_MOCK_MARKETPLACE=false

# SEO: URL gốc của site (canonical, og:url, og:image), vd. https://a51.vn - bỏ trống = origin hiện tại
# VITE_SEO_IMAGE: ảnh chia sẻ mặc định, bỏ trống = /image/default-banner.png
VITE_SITE_URL=
VITE_SEO_IMAGE=

# Đăng nhập bằng Google: OAuth Client ID loại "Web application" (bỏ trống = ẩn nút Google)
# Trên Google Cloud Console phải thêm origin chạy frontend vào "Authorized JavaScript origins", vd. http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
